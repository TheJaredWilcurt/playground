{
  "name": "playground",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prestart": "node ./scripts/prestart.js",
    "prebuild": "node ./scripts/prebuild.js",
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview --port 4173",
    "get-categories": "node ./scripts/getCategories.js",
    "lint": "eslint --ext .js,.vue src scripts vite.config.js eslint.config.js",
    "fix": "npm run lint -- --fix",
    "proto": "proto pin node latest --resolve --tool-native && git status"
  },
  "ManifestComments": [],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.11",
    "@sarap422/font-dinish": "^1.0.6",
    "@shikijs/langs": "^4.4.3",
    "@thejaredwilcurt/csslop": "^0.0.35",
    "buffer": "^6.0.3",
    "clean-css": "^5.3.3",
    "codemirror": "^6.0.2",
    "csskit": "^0.0.32-canary.ca41e47b5a",
    "cssnano": "^9.0.2",
    "cssnano-preset-advanced": "^9.0.2",
    "csso": "^5.0.5",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "lightningcss-wasm": "^1.33.0",
    "normalize.css": "^8.0.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.28",
    "pretty-ms": "^9.3.1",
    "sass": "^1.104.0",
    "shiki": "^4.4.3",
    "string_decoder": "^1.3.0",
    "vue": "^3.5.42",
    "vue-doxen": "^0.13.4",
    "vue-options-api-constants-plugin": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-vue": "^4.0.1",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0"
    }
  }
}
