{
  "name": "playground",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prestart": "node ./scripts/pre/start.js",
    "start": "npm run dev",
    "dev": "vite",
    "preview": "npm run build && vite preview --port 4173",
    "prebuild": "node ./scripts/pre/build.js",
    "build": "vite build",
    "get-categories": "node ./scripts/getCategories.js",
    "lint": "eslint --ext .js,.vue src scripts vite.config.js eslint.config.js",
    "fix": "npm run lint -- --fix",
    "outdated": "npx --yes -- check-outdated --columns package,current,wanted,latest --types major,minor,patch",
    "proto": "proto pin node latest --resolve --tool-native && proto pin npm latest --resolve --tool-native && git status"
  },
  "ManifestComments": [],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.44.2",
    "@sarap422/font-dinish": "^1.0.6",
    "@shikijs/langs": "^4.6.0",
    "@thejaredwilcurt/csslop": "^0.0.70",
    "buffer": "^6.0.3",
    "clean-css": "^5.3.3",
    "codemirror": "^6.0.2",
    "csskit": "^0.0.42-canary.202611210314",
    "cssnano": "^9.9.0",
    "cssnano-preset-advanced": "^10.0.0",
    "csso": "^5.0.5",
    "diff": "^9.0.0",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "lightningcss-wasm": "^1.33.0",
    "normalize.css": "^8.0.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.33",
    "pretty-ms": "^10.0.0",
    "sass": "^1.108.2",
    "string_decoder": "^1.4.0",
    "vue": "^3.5.46",
    "vue-doxen": "^0.13.5",
    "vue-options-api-constants-plugin": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-tjw-base": "^5.0.1",
    "eslint-config-tjw-import-x": "^1.0.2",
    "eslint-config-tjw-vue": "^4.0.2",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "shiki": "^4.6.0",
    "vite": "^8.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.3"
    }
  }
}
